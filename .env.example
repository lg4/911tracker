# Poll cadence in milliseconds. Default = 10 minutes (~144 req/day, trivially light on the county site).
POLL_INTERVAL_MS=600000

# Primary structured source (JSON) and HTML fallback cross-check source.
FEED_URL=https://oneidacountyny.gov/_incidents/incidents
HTML_FEED_URL=https://oneidacountyny.gov/_incidents/getAcitivityFeedList/

# Identify ourselves clearly and be polite (robots.txt disallows /_incidents; keep load minimal).
USER_AGENT=oneida-911-mapper/1.0 (+self-hosted public dashboard)

# Postgres connection string used by the ingestion store.
DATABASE_URL=postgres://oneida:oneida@localhost:5432/oneida911

# Set to "false" to disable automatic polling (useful for tests / manual runs).
RUN_INGEST=true
